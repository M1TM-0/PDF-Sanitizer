# Template for pdf-sanitizer's persisted configuration.
#
# This is NOT read directly -- copy it to ".env" (which is gitignored,
# since it's local runtime state, not something to version-control) if
# you want an explicit, editable file to start from:
#
#   cp .env.example .env
#
# You don't need this file at all to get these values: every default
# below is already pdf_sanitizer.config.Settings' own built-in default,
# so a fresh checkout with no ".env" behaves identically. The normal way
# to change any of this is:
#
#   ./sanitize config set --max-pages 1000 --max-input-size 500M \
#     --max-output-size 3G --memory 4G --timeout 600 --dpi 150 \
#     --format jpeg --jpeg-quality 90
#
# (or `pdf-sanitizer config set ...` if you installed the package
# directly, without Docker) -- which validates every value and writes
# ".env" for you. See README "Limites configuráveis" / "Configuração
# rápida" for what each setting does.
#
# Both this project's own Python config loader and `docker compose`'s
# `.env` parser expect exactly `KEY=VALUE`, one per line -- no quotes,
# no shell expansion, no inline comments after a value.

# Maximum number of pages processed. Pages beyond this are rejected
# before rendering begins.
PDF_SANITIZER_MAX_PAGES=300

# Maximum size of the *input* PDF, rejected before any processing starts.
# Accepts a human-readable size ("500M", "1G") anywhere it can be set.
PDF_SANITIZER_MAX_INPUT_BYTES=524288000

# Maximum size of the *sanitized output*. Exceeding this discards the
# output entirely (nothing partially written) and reports an error.
PDF_SANITIZER_MAX_OUTPUT_BYTES=3221225472

# RAM budget for one sanitization job: drives BOTH the container's cgroup
# mem_limit/memswap_limit (docker-compose.yml) and, with a safety margin
# subtracted, the isolated worker's own RLIMIT_AS.
PDF_SANITIZER_MAX_MEMORY_BYTES=2147483648

# Wall-clock timeout for one job, enforced by the parent process
# regardless of what the worker itself is doing.
PDF_SANITIZER_PROCESSING_TIMEOUT_SECONDS=600

# Rendering resolution. Higher = sharper output, more RAM, slower, larger
# files. 150 is a solid default for text documents; 200+ for documents
# with fine print or small photos.
PDF_SANITIZER_RENDER_DPI=150

# Page raster format for the reconstructed PDF: "png" or "jpeg". JPEG
# (the default) is dramatically smaller for photographic/scanned pages;
# PNG is lossless. Neither changes the security model -- rasterization
# itself is the security boundary either way.
PDF_SANITIZER_OUTPUT_IMAGE_FORMAT=jpeg

# JPEG quality, 1-100. Only used when OUTPUT_IMAGE_FORMAT=jpeg. Lower
# values shrink output further at some cost to visual fidelity.
PDF_SANITIZER_JPEG_QUALITY=90

# Size of the tmpfs backing the isolated per-job temp directory (rendered
# page images before reconstruction). Docker-only -- the Python package
# itself does not create a tmpfs. Driven by page count x DPI, not by the
# input file's raw size, so it's independent of MAX_INPUT_BYTES.
PDF_SANITIZER_TMPFS_SIZE=2147483648
